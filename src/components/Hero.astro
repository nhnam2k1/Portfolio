---
import Avatar from "./Avatar.astro";
import { profile } from "../assets/data/profile.ts";

const cvUrl = `${import.meta.env.BASE_URL}${profile.cvUrl}`;
---

<section
  id="top"
  class="pt-20 md:pt-32 pb-12 md:pb-20 scroll-mt-20"
>
  <div
    class="max-w-6xl mx-auto px-6 flex flex-col-reverse md:flex-row items-center gap-10 md:gap-16"
  >
    <div class="flex-1 text-center md:text-left">
      <p
        class="font-mono text-xs uppercase tracking-widest text-accent-600 dark:text-accent-400 mb-3"
      >
        {profile.location} · Open to opportunities
    </p>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-3"
      >
        {profile.name}
  </h1>
      <h2
        class="text-xl md:text-2xl font-medium text-slate-700 dark:text-slate-300 mb-5"
      >
        {profile.tagline}
  </h2>
      <p
        class="text-base md:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto md:mx-0 mb-8 leading-relaxed"
      >
        {profile.bio}
  </p>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
        <a
          href="#projects"
          class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded-md bg-accent-600 text-white hover:bg-accent-700 transition-colors"
        >
          View Projects
    </a>
        <a
          href={cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded-md border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-accent-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        >
          Download CV
    </a>
  </div>
</div>

    <div class="shrink-0">
      <Avatar initials={profile.initials} size="xl" />
  </div>
</div>
</section>
