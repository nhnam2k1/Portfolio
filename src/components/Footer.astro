---
import { profile } from "../assets/data/profile.ts";
---

<footer
  class="border-t border-slate-200 dark:border-slate-800 mt-auto py-10"
>
  <div
    class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4"
  >
    <p class="text-sm text-slate-500 dark:text-slate-400">
      © {new Date().getFullYear()} {profile.name}. Built with Astro.
    </p>
  </div>
</footer>
