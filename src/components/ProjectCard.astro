---
import * as Lucide from "lucide-react";
import { type Project } from "../assets/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="group relative rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 hover:border-accent-500 dark:hover:border-accent-500 transition-colors flex flex-col"
>
  <div
    class="aspect-video rounded-md bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 border border-slate-200 dark:border-slate-800 mb-5 flex items-center justify-center overflow-hidden"
  >
    <Lucide.Code2 size={48} className="text-slate-400 dark:text-slate-600" aria-hidden="true" />
  </div>

  <h3
    class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors"
  >
    {project.title}
  </h3>

  <p
    class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4"
  >
    {project.summary}
  </p>

  <ul class="flex flex-wrap gap-1.5 mb-5">
    {
      project.stack.map((s) => (
        <li>
          <span class="inline-block px-2 py-0.5 text-xs font-mono rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            {s}
          </span>
        </li>
      ))
    }
  </ul>

  <ul class="space-y-1.5 text-sm text-slate-700 dark:text-slate-300 mb-5 flex-1">
    {
      project.highlights.map((h) => (
        <li class="relative pl-5 leading-relaxed">
          <span
            class="absolute left-0 top-2 w-1.5 h-1.5 rounded-full bg-accent-500 shrink-0"
            aria-hidden="true"
          />
          <span>{h}</span>
        </li>
      ))
    }
  </ul>

  <div class="flex items-center gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
    {
      project.repoUrl && (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        >
          <Lucide.Code2 size={14} aria-hidden="true" />
          Code
        </a>
      )
    }
    {
      project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
        >
          <Lucide.ExternalLink size={14} aria-hidden="true" />
          Portfolio
        </a>
      )
    }
  </div>
</article>
