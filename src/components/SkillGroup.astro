---
import type { SkillGroup as SkillGroupType } from "../assets/data/skills.ts";

interface Props {
  group: SkillGroupType;
}

const { group } = Astro.props;
---

<div>
  <h3
    class="font-mono text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4"
  >
    {group.category}
</h3>
  <ul class="flex flex-wrap gap-2">
    {
      group.skills.map((s) => (
        <li>
          <span
            class:list={[
              "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-accent-500 hover:text-accent-600 dark:hover:text-accent-400 transition-colors",
            ]}
          >
            <span class="font-medium">{s.name}</span>
            {s.years !== undefined && (
              <span class="text-xs text-slate-500 dark:text-slate-500 font-mono">
                {s.years}y
             </span>
            )}
  </span>
       </li>
      ))
    }
</ul>
</div>
