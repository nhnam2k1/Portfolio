---
import * as Lucide from "lucide-react";
import { type Education } from "../assets/data/education";

interface Props {
  education: Education;
}

const { education: ed } = Astro.props;
---

<article
  class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 hover:border-accent-500 dark:hover:border-accent-500 transition-colors"
>
  <div class="flex items-start gap-3 mb-3">
    <div
      class="shrink-0 w-10 h-10 rounded-md bg-accent-500/10 text-accent-600 dark:text-accent-400 flex items-center justify-center"
    >
      <Lucide.GraduationCap size={20} aria-hidden="true" />
    </div>
    <div class="flex-1">
      <h3
        class="text-lg font-semibold text-slate-900 dark:text-slate-100 mb-0.5"
      >
        {ed.school}
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400">{ed.degree}</p>
    </div>
  </div>

  <div
    class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-mono text-slate-500 dark:text-slate-400 mb-4"
  >
    <span class="inline-flex items-center gap-1">
      <Lucide.Calendar size={12} aria-hidden="true" />
      {ed.period}
    </span>
    <span class="inline-flex items-center gap-1">
      <Lucide.MapPin size={12} aria-hidden="true" />
      {ed.location}
    </span>
  </div>

  <ul class="space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
    {
      ed.notes.map((n) => (
        <li class="relative pl-5 leading-relaxed">
          <span
            class="absolute left-0 top-2 w-1.5 h-1.5 rounded-full bg-accent-500 shrink-0"
            aria-hidden="true"
          />
          <span>{n}</span>
        </li>
      ))
    }
  </ul>
</article>
